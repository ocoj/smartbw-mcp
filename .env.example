# SmartBW MCP 环境变量配置示例
# 复制为 ~/.config/bitwarden-mcp/.env 并修改
# 环境变量优先级高于 config.json
#
# BW_HOST, BW_EMAIL, BW_MASTER_PASSWORD 与 Bitwarden CLI (bw) 兼容，
# 同时设置在 config.json 和 .env 时，.env 优先。

BW_HOST=""
BW_EMAIL=""
BW_MASTER_PASSWORD=""
BW_CLIENTID=""
BW_CLIENTSECRET=""

# 可选：自定义运行参数
# SMARTBW_MCP_TIMEOUT=30
# SMARTBW_FUZZY_THRESHOLD=0.5
# SMARTBW_CONFIG_DIR="~/.config/bitwarden-mcp"
