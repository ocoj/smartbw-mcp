[Unit]
Description=SmartBW MCP Daemon - Vaultwarden 代理守护进程
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 占位符模板：本文件不能直接使用，需由安装脚本渲染 __PYTHON__ / __SCRIPT_DIR__ 后
# 写入 ~/.config/systemd/user/。install.sh 会自行生成单元文件；另有内部安装脚本
# 会对本文件做 sed 渲染（该脚本不随仓库发布）。切勿在此填写个人绝对路径（对他人必然不存在）。
ExecStart=__PYTHON__ __SCRIPT_DIR__/mcp_daemon.py
Restart=always
RestartSec=10
# 日志由 mcp_daemon.py 的 TimedRotatingFileHandler 写入 ~/.smartbw-mcp/daemon.log（保留 30 天）。
# 切勿在此把 stdout/stderr 重定向到同一文件：会造成每行日志重复，且 systemd 持有旧 fd 导致轮转失效。
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
